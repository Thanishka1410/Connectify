# Frontend Environment Variables
# In development with Vite proxy, empty values use relative endpoints (/api and /socket.io)
# For production deployment (e.g. Vercel), point to your deployed backend URL:
# VITE_API_URL=https://your-connectify-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-connectify-backend.onrender.com

VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
