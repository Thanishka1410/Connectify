# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/connectify
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/connectify?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/connectify

# JWT Secret Key for Token Generation
JWT_SECRET=connectify_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS and Socket.IO
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Configuration for Image Uploads
# If left empty, Connectify automatically falls back to local disk storage (/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
